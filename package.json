{
  "name": "@pragma/monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pragma-monitor": "dist-server/server/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts --dev",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test server/*.test.ts src/lib/*.test.ts",
    "format": "prettier --plugin prettier-plugin-svelte --write src server tests *.ts *.js *.json",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.66.0",
    "@xyflow/svelte": "^1.0.0",
    "elkjs": "^0.12.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
